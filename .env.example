# Copy to .env and adjust. Both compose.yaml and the app read from .env.

# --- Postgres container (read by compose.yaml) ---
POSTGRES_USER=ccbc
POSTGRES_PASSWORD=change_me
POSTGRES_DB=ccbc
POSTGRES_PORT=5432

# --- App ---
# Payload uses DATABASE_URI, not DATABASE_URL.
DATABASE_URL=postgresql://ccbc:change_me@localhost:5432/ccbc

# Added by create-payload-app; generate with: openssl rand -hex 32
# PAYLOAD_SECRET=
